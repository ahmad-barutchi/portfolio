---
/**
 * Tuile 1×1 d'un projet de hackathon (DeepVision, Single Digital Gateway) :
 * la tuile entière est un lien vers le dépôt GitHub. Glyphe SVG décoratif,
 * pastille ↗, méta, titre, lieu, et la description du projet :
 *  - avec une souris (≥ 621 px), elle remplace le glyphe en fondu au survol / focus ;
 *  - sinon (tactile, petit écran), elle est toujours visible sous le texte.
 */
import Tile from './Tile.astro';
import Icon from '../Icon.astro';
import type { ProjectTile } from '../../data/site';
import { useI18n } from '../../i18n';

interface Props {
  tile: ProjectTile;
}

const { t } = useI18n(Astro);
const { tile } = Astro.props;
const id = `projet-${tile.id}`;
const glyph = tile.id === 'sdg' ? 'eu' : 'iris';

/** Anneau de 12 étoiles façon drapeau européen (rayon 44, centre 60). */
const stars = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  return {
    cx: +(60 + 44 * Math.sin(a)).toFixed(1),
    cy: +(60 - 44 * Math.cos(a)).toFixed(1),
    on: i === 0,
  };
});
---

<Tile
  variant="sm"
  href={tile.href}
  aria-label={t.projects.tileAria(tile.title)}
  aria-describedby={`${id}-meta ${id}-sub ${id}-desc`}
>
  <div class="inner">
    {glyph === 'iris' ? (
      <svg class="glyph" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <circle class="ring dash" cx="60" cy="60" r="56" />
        <circle class="ring" cx="60" cy="60" r="40" />
        <circle class="ring" cx="60" cy="60" r="24" />
        <circle class="pupil" cx="60" cy="60" r="9" />
      </svg>
    ) : (
      <svg class="glyph" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
        <g class="stars">
          {stars.map((s) => (
            <circle class:list={['star', { on: s.on }]} cx={s.cx} cy={s.cy} r={s.on ? 4.2 : 3.4} />
          ))}
        </g>
        <path class="arch" d="M47 78V61a13 13 0 0 1 26 0v17" />
        <path class="arch" d="M40 78h40" />
      </svg>
    )}
    <span class="go" aria-hidden="true">
      <Icon name="arrow-up-right" size={16} />
    </span>

    <div class="txt">
      <p id={`${id}-meta`} class="mono">
        {tile.meta}
      </p>
      <h3 class="h3">{tile.title}</h3>
      <p id={`${id}-sub`} class="sub">
        {tile.sub}
      </p>
    </div>

    <p id={`${id}-desc`} class="desc">
      {tile.description}
    </p>
  </div>
</Tile>

<style>
  .inner {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(20px, 1fr) auto auto;
    column-gap: 12px;
  }

  .glyph {
    grid-area: 1 / 1;
    width: 72px;
    height: 72px;
    color: var(--fg-3);
    transition:
      opacity 0.35s var(--ease),
      transform 0.5s var(--ease);
  }

  .go {
    grid-area: 1 / 2;
    align-self: start;
  }

  .txt {
    grid-area: 3 / 1 / 4 / 3;
  }

  .h3 {
    margin-top: 12px;
  }

  .desc {
    grid-area: 4 / 1 / 5 / 3;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  /* Glyphes */
  .ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.7;
  }

  .dash {
    stroke-dasharray: 3 5;
    transform-origin: 60px 60px;
    animation: proj-turn 30s linear infinite;
  }

  .pupil {
    fill: var(--accent);
    transform-origin: 60px 60px;
    transition: transform 0.6s var(--ease);
  }

  .stars {
    transform-origin: 60px 60px;
    transition: transform 1.2s var(--ease);
  }

  .star {
    fill: currentColor;
    opacity: 0.75;
  }

  .star.on {
    fill: var(--accent);
    opacity: 1;
  }

  .arch {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    opacity: 0.8;
  }

  :global(.tile:hover) .pupil {
    transform: scale(1.7);
  }

  :global(.tile:hover) .stars {
    transform: rotate(30deg);
  }

  @keyframes proj-turn {
    to {
      transform: rotate(360deg);
    }
  }

  /* Souris et place suffisante : la description remplace le glyphe au survol. */
  @media (hover: hover) and (pointer: fine) and (min-width: 621px) {
    .desc {
      grid-area: 1 / 1 / 2 / 3;
      align-self: start;
      margin: 0;
      padding: 0;
      border: 0;
      font-size: 13.5px;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.35s var(--ease),
        transform 0.5s var(--ease);
    }

    /* Réserve la place de la pastille ↗ en haut à droite. */
    .desc::before {
      content: '';
      float: right;
      width: 46px;
      height: 40px;
    }

    :global(.tile:hover) .desc,
    :global(.tile:focus-visible) .desc {
      opacity: 1;
      transform: none;
    }

    :global(.tile:hover) .glyph,
    :global(.tile:focus-visible) .glyph {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @media (max-width: 620px) {
    .glyph {
      width: 52px;
      height: 52px;
    }

    .h3 {
      font-size: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dash {
      animation: none;
    }
  }
</style>
