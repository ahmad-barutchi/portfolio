---
/**
 * Filet de 1 px qui se dessine à l'entrée, parcouru toutes les 5,5 s par un
 * « paquet » couleur accent. Purement décoratif.
 */
---

<div class="rule" aria-hidden="true"></div>

<style>
  .rule {
    position: relative;
    height: 1px;
    background: var(--line-2);
    overflow: hidden;
    transform-origin: 0 50%;
    animation: signal-draw 1.4s var(--ease) 0.35s both;
  }

  .rule::after {
    content: '';
    position: absolute;
    top: 0;
    left: -18%;
    width: 18%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: signal-packet 5.5s var(--ease) 1.6s infinite;
  }

  @keyframes signal-draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes signal-packet {
    0% {
      left: -18%;
    }
    55%,
    100% {
      left: 100%;
    }
  }
</style>
