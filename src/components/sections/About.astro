---
/**
 * 01 — À propos : portrait bichromie (encre / ambre, couleur au survol, inclinaison 3D)
 * et récit. Référence : maquette About.dc.html.
 */
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import portrait from '../../assets/portrait.jpg';
import { ABOUT, PROFILE, SECTIONS } from '../../data/site';

const latitude = PROFILE.coords.split(' · ')[0];
---

<Section id="a-propos" index={SECTIONS['a-propos'].index} label={SECTIONS['a-propos'].label}>
  <Fragment slot="title">
    D’Alep à Namur, <em class="serif">une ligne</em> à la fois.
  </Fragment>

  <div class="about-grid">
    <figure class="portrait reveal" data-portrait>
      <div class="frame" data-portrait-frame>
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1280px) 500px, (min-width: 981px) 40vw, (min-width: 520px) 440px, 100vw"
          alt={ABOUT.portraitAlt}
          loading="lazy"
          decoding="async"
        />
        <div class="tint" aria-hidden="true"></div>
        <div class="dots" aria-hidden="true"></div>
        <span class="tag" aria-hidden="true">
          <span class="beacon"></span>
          {PROFILE.city} · {latitude}
        </span>
      </div>
      <figcaption>
        <span class="mono">{PROFILE.name}</span>
        <span class="mono">{PROFILE.role}</span>
      </figcaption>
    </figure>

    <div class="story">
      <p class="lead reveal" set:html={ABOUT.lead} />
      {ABOUT.paragraphs.map((text) => (
        <p class="body reveal">{text}</p>
      ))}
      <dl class="facts reveal">
        {ABOUT.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .portrait {
    position: relative;
  }

  .frame {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 24px;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-3);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow);
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease);
  }

  .frame :global(picture),
  .frame :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame :global(img) {
    object-fit: cover;
    filter: grayscale(1) contrast(1.12) brightness(1.02);
    transform: scale(1.02);
    transition:
      filter 0.9s var(--ease),
      transform 0.9s var(--ease);
  }

  .tint {
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: multiply;
    transition: opacity 0.9s var(--ease);
  }

  .dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in oklch, var(--ink) 55%, transparent) 1px,
      transparent 1.4px
    );
    background-size: 7px 7px;
    mix-blend-mode: multiply;
    opacity: 0.28;
    transition: opacity 0.9s var(--ease);
  }

  .portrait:hover .frame :global(img) {
    filter: none;
    transform: scale(1.05);
  }

  .portrait:hover .tint,
  .portrait:hover .dots {
    opacity: 0;
  }

  .tag {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgb(14 16 24 / 0.72);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #f3efe6;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag .beacon {
    width: 6px;
    height: 6px;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 6px;
  }

  .lead :global(em) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.08em;
    letter-spacing: -0.005em;
  }

  .story .body {
    font-size: 17px;
    max-width: 60ch;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin-top: 14px;
  }

  .facts div {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  dd {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--fg);
  }

  @media (max-width: 980px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 440px;
    }
  }

  @media (max-width: 620px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .story .body {
      font-size: 16px;
    }
  }
</style>

<script>
  // Inclinaison 3D du portrait (≤ 4°) vers le pointeur ; souris uniquement, hors reduced-motion.
  const figure = document.querySelector<HTMLElement>('[data-portrait]');
  const frame = figure?.querySelector<HTMLElement>('[data-portrait-frame]');
  if (
    figure &&
    frame &&
    matchMedia('(pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    let raf = 0;
    let px = 0;
    let py = 0;
    const apply = () => {
      raf = 0;
      frame.style.setProperty('--ry', `${(px * 8).toFixed(2)}deg`);
      frame.style.setProperty('--rx', `${(-py * 8).toFixed(2)}deg`);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(apply);
    };
    figure.addEventListener(
      'pointermove',
      (e) => {
        const b = figure.getBoundingClientRect();
        px = (e.clientX - b.left) / b.width - 0.5;
        py = (e.clientY - b.top) / b.height - 0.5;
        schedule();
      },
      { passive: true },
    );
    figure.addEventListener('pointerleave', () => {
      px = 0;
      py = 0;
      schedule();
    });
  }
</script>
